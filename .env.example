# Copy this file to .env.local and fill in the real values.
# Find them in your Supabase dashboard: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# --- Server-only secrets (NO "NEXT_PUBLIC_" prefix: never sent to browsers) ---
# Supabase → Project Settings → API Keys → "Secret key" (sb_secret_…).
# Lets the server save submitted events and power the admin page.
SUPABASE_SECRET_KEY=your-secret-key-here
# Password for /admin (where you approve submitted events). 12+ characters.
ADMIN_PASSWORD=choose-a-long-password
