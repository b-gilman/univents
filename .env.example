# Copy this file to .env.local and fill in the real values.
# Find them in your Supabase dashboard: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# --- Server-only secrets (NO "NEXT_PUBLIC_" prefix: never sent to browsers) ---
# Supabase → Project Settings → API Keys → "Secret key" (sb_secret_…).
# Lets the server save submitted events and power the admin page.
SUPABASE_SECRET_KEY=your-secret-key-here
# Password for /admin (where you approve submitted events). 12+ characters.
ADMIN_PASSWORD=choose-a-long-password

# --- Email (Resend) ---
# Resend → API Keys. Used for event reminder emails.
RESEND_API_KEY=your-resend-api-key
# Who reminder emails come from (must be on your verified Resend domain).
EMAIL_FROM=Kuku <hello@kukucanada.dev>
# Any long random string. Vercel sends it to /api/cron/reminders so nobody
# else can trigger the reminder emails.
CRON_SECRET=make-up-a-long-random-string

# "Import from screenshots" in the admin (Claude reads club posts).
# Create a key at console.anthropic.com → API Keys. Server-only: never
# put it in a variable starting with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=your-anthropic-api-key
